# ============================================================================
# Environment configuration for ai-shai-web-interface
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values marked with placeholders
# (e.g. `!!!YOUR_KEY_HERE!!!`). Do NOT commit real secrets.
# ============================================================================

# OPCP Companion (RAG) Configuration
# OVH AI Endpoints (embeddings)
OVH_AI_ENDPOINT=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_TOKEN=!!!YOUR_KEY_HERE!!!
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_DIM=4096

# OVH AI Endpoints (LLM generation) — leave endpoint/token blank to reuse the
# embedding endpoint/token, or set them explicitly for a dedicated LLM.
LLM_ENDPOINT=
LLM_TOKEN=
LLM_MODEL=Qwen3-Embedding-8B

# pgvector Postgres connection (aligned with DATABASE_URL: shai_db @ postgres)
PG_HOST=postgres
PG_PORT=5432
PG_DB=shai_db
PG_USER=shai_user
PG_PASSWORD=!!!YOUR_PASSWORD_HERE!!!
TABLE_NAME=md_embeddings

# Shai provider (OVH OpenAI-compatible endpoint). The provider now calls this
# HTTP endpoint directly (no CLI subprocess) through a reused client.
SHAI_API_KEY=!!!YOUR_KEY_HERE!!!
SHAI_API_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
SHAI_MODEL=Qwen2.5-Coder-32B-Instruct

# ----------------------------------------------------------------------------
# Database field encryption (optional, OFF by default)
# ----------------------------------------------------------------------------
# Application-level encryption of a small set of sensitive free-text columns.
# Toggled from the admin Configuration page. The administrator supplies a
# password key there; only a salted verification hash is stored in the DB — the
# password key itself is never persisted.
#
# DB_ENCRYPTION_KEY is an OPTIONAL, ready-to-use Fernet key that seeds the
# in-memory key holder at startup so the app can decrypt encrypted columns
# without an admin re-entering the password key after each restart. Leave it
# empty to require runtime key entry via the admin API.
#
# WARNING: if encryption is enabled and the password key (and this derived key)
# are lost, the encrypted data is PERMANENTLY unrecoverable by design.
DB_ENCRYPTION_KEY=
