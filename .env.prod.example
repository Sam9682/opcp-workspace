# ============================================================================
# Environment configuration for ai-shai-web-interface
# ----------------------------------------------------------------------------
# Generated with safe DEFAULTS for local/dev use.
# BEFORE DEPLOYING TO PRODUCTION, replace every value marked "CHANGE_ME":
#   - SECRET_KEY  (use a long random string, e.g. `openssl rand -hex 32`)
#   - POSTGRES_PASSWORD / the password inside DATABASE_URL
#   - SMTP_* and payment provider credentials
# ============================================================================

# --- Database ---------------------------------------------------------------
# DATABASE_URL host is "postgres" to match the docker-compose service name.
DATABASE_URL=postgresql://shai_user:shai_password@postgres:5432/shai_db
POSTGRES_PASSWORD=shai_password

# --- Security ---------------------------------------------------------------
SECRET_KEY=CHANGE_ME_use_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@opcp-psmc.com

# --- Payment (dummy values are fine for dev) --------------------------------
STRIPE_API_KEY=sk_test_dummy_key
STRIPE_WEBHOOK_SECRET=whsec_dummy_secret
PAYPAL_CLIENT_ID=dummy_client_id
PAYPAL_CLIENT_SECRET=dummy_client_secret
PAYPAL_MODE=sandbox

# --- Application ------------------------------------------------------------
APP_NAME=AI-SHAI
APP_VERSION=1.0.0
DEBUG=False
ALLOWED_ORIGINS=http://ai-shai-web-interface:8000,http://frontend,https://opcp-psmc.com

# --- Docker ports (host side) -----------------------------------------------
HTTP_PORT=6000
HTTP_PORT2=6002
HTTPS_PORT=6001
FRONTEND_PORT=6003

# --- File storage -----------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE=10485760
DOCS_SEED_DIR=./docs/to_publish

# --- Membership -------------------------------------------------------------
ANNUAL_MEMBERSHIP_FEE=50.00

# --- Domain / deployment ----------------------------------------------------
DOMAIN=opcp-psmc.com
API_URL=https://opcp-psmc.com
SSL_EMAIL=admin@softfluid.fr

# --- Frontend ---------------------------------------------------------------
REACT_APP_API_URL=https://opcp-psmc.com

# --- Oracle AI (optional; Kiro AI is the default, no config needed) ---------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4
# SHAI_API_KEY=
# SHAI_API_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1


# Domain Configuration
DOMAIN=opcp-psmc.com
API_URL=https://opcp-psmc.com
SSL_EMAIL=admin@opcp-psmc.com

# Frontend
REACT_APP_API_URL=https://opcp-psmc.com

# OPCP Companion (RAG) Configuration
# OVH AI Endpoints (embeddings)
OVH_AI_ENDPOINT=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_TOKEN=!!!YOUR_KEY_HERE!!!
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_DIM=4096

# OVH AI Endpoints (LLM generation) — leave endpoint/token blank to reuse the
# embedding endpoint/token, or set them explicitly for a dedicated LLM.
LLM_ENDPOINT=
LLM_TOKEN=
LLM_MODEL=Qwen3-Embedding-8B

# Base Postgres pgvector
PG_HOST=postgres
PG_PORT=5432
PG_DB=shai_db
PG_USER=shai_user
PG_PASSWORD=!!!YOUR_PASSWORD_HERE!!!
TABLE_NAME=md_embeddings